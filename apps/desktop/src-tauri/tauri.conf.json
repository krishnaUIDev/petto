{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc.json",
  "productName": "Petto",
  "version": "0.1.9",
  "identifier": "com.petto.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Petto Companion",
        "label": "pet",
        "url": "/#pet",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      },
      {
        "title": "Petto Dashboard & Adoption Wizard",
        "label": "editor",
        "url": "/#editor",
        "width": 960,
        "height": 680,
        "transparent": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
